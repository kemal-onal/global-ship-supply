# ─── Runtime ────────────────────────────────────────────────────────
ENVIRONMENT=development  # development | staging | production | docker
LOG_LEVEL=INFO

# ─── Database (async SQLAlchemy) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://avs:avs-dev-password@localhost:5432/avs
SYNC_DATABASE_URL=postgresql+psycopg2://avs:avs-dev-password@localhost:5432/avs
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ─── Cache / IDS/IPS backing store ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT (RS256) ────────────────────────────────────────────────────
# In dev, the app will generate an ephemeral keypair on first boot if
# these files don't exist.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
JWT_ISSUER=avs.global
JWT_AUDIENCE=avs.web

# ─── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost

# ─── Security / IDS-IPS ────────────────────────────────────────────
MAX_LOGIN_FAILURES=5
LOGIN_FAIL_WINDOW_SECONDS=300
RATE_LIMIT_PER_MINUTE=120
PORT_SCAN_THRESHOLD=60
PORT_SCAN_WINDOW_SECONDS=60

# ─── RFQ weighting (must sum to 1.0) ───────────────────────────────
RFQ_WEIGHT_PRICE=0.4
RFQ_WEIGHT_LEAD_TIME=0.2
RFQ_WEIGHT_RELIABILITY=0.2
RFQ_WEIGHT_QUALITY=0.2
RFQ_DEFAULT_TTL_HOURS=72

# ─── Catering defaults ─────────────────────────────────────────────
DEFAULT_VOYAGE_BUFFER_DAYS=2
DEFAULT_VOYAGE_BUFFER_PCT=0.10

# ─── Cookie auth ───────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
